# --- Database (path is relative to prisma/schema.prisma) ---
DATABASE_URL="file:../data/commcoach.db"

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# The app password and your chat aliases are NOT set here any more.
# The first-run wizard at /setup asks for them and stores them in
# data/settings.json. Old installs that still have APP_PASSWORD /
# SELF_ALIASES in .env.local keep working — run `npm run setup:migrate`
# to move them across.

# --- Phase 2+ (not used by the MVP) ---
TRANSCRIBE_PROVIDER=local
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
